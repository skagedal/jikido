#!/usr/bin/env bash
#
# Cut a release: tag the next version with a message, and push the tag.
#
#   ./local/release patch "The volume shows before you sit."
#   ./local/release minor "Pausing."
#   ./local/release major "Everything is different." --yes
#
# Both the bump and the message are required. The message is what testers
# read: it becomes the build's "What to Test" notes in TestFlight. Pushing
# the tag is what starts .github/workflows/release.yml, so it asks first
# unless given --yes.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

die() {
    echo "release: $*" >&2
    exit 1
}

usage() {
    die "usage: local/release major|minor|patch <message> [--yes]"
}

assume_yes=false
positional=()
while [ $# -gt 0 ]; do
    case "$1" in
        --yes | -y) assume_yes=true ;;
        -*) usage ;;
        *) positional+=("$1") ;;
    esac
    shift
done
[ "${#positional[@]}" -eq 2 ] || usage
bump="${positional[0]}"
message="${positional[1]}"
case "$bump" in
    major | minor | patch) ;;
    *) usage ;;
esac
[ -n "${message//[[:space:]]/}" ] || usage

cd "$root"

branch="$(git symbolic-ref --quiet --short HEAD || true)"
[ "$branch" = main ] || die "on ${branch:-a detached HEAD}, not main."

[ -z "$(git status --porcelain)" ] || die "the working tree has changes. Commit or stash them first."

git fetch --quiet --tags origin main
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] ||
    die "main is not the same commit as origin/main. The tag should name a commit CI has seen."

# The same rule the workflow enforces: v and one to three integers. Missing
# parts count as zero.
latest="$(git tag -l 'v*' |
    sed -n 's/^v\([0-9][0-9]*\)\(\.\([0-9][0-9]*\)\)\{0,1\}\(\.\([0-9][0-9]*\)\)\{0,1\}$/\1 \3 \5/p' |
    awk '{ printf "%d %d %d\n", $1, $2, $3 }' |
    sort -k1,1n -k2,2n -k3,3n |
    tail -n 1)"
read -r major minor patch <<EOF
${latest:-0 0 0}
EOF

case "$bump" in
    major) major=$((major + 1)) minor=0 patch=0 ;;
    minor) minor=$((minor + 1)) patch=0 ;;
    patch) patch=$((patch + 1)) ;;
esac
tag="v$major.$minor.$patch"

git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null && die "$tag already exists."

printf 'Tagging %s at %s with:\n\n%s\n\n' "$tag" "$(git log -1 --format='%h %s')" "$message" >&2

if [ "$assume_yes" != true ]; then
    printf 'Push it, and release? [y/N] ' >&2
    read -r answer
    case "$answer" in
        y | Y | yes) ;;
        *) die "nothing tagged." ;;
    esac
fi

git tag -a "$tag" -m "$message"
git push origin "refs/tags/$tag"

echo "release: pushed $tag. Follow it with: gh run watch" >&2
